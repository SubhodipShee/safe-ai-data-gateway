# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas → Clusters → Connect → Drivers (add the database name after .net/)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/safe-ai-gateway

# 32 random bytes, base64. Generate with: npm run gen-key
# Encrypts the vault. Lose it = vault data can't be decrypted. Leak it = vault is readable.
MASTER_KEY=

# How long hidden values are kept before they're deleted automatically (hours).
SESSION_TTL_HOURS=24

# Find people's names with a local AI model (downloads ~110 MB once; gateway uses ~290 MB RAM in total).
NAME_DETECTION=on

PORT=7000
# 127.0.0.1 = only this computer. Online (Render) it's 0.0.0.0, which turns on
# public mode: HTTPS redirect, rate limits, and ADMIN_KEY becomes required.
HOST=127.0.0.1

# Password for changing policies on the dashboard (at least 16 characters).
# Optional on your laptop; required online. Generate with: npm run gen-key
ADMIN_KEY=

# Optional. Set this if you get "querySrv ECONNREFUSED" (your system DNS refuses SRV lookups).
DNS_SERVERS=8.8.8.8,1.1.1.1

# Phase 7: the AI provider behind /v1/chat/completions (all free options):
#   groq   → free key, no card: https://console.groq.com → API Keys   (recommended)
#   gemini → free key at https://aistudio.google.com (small free quota)
#   ollama → runs on your own PC, no key needed
AI_PROVIDER=groq
AI_API_KEY=
# Optional: a specific model (run "npm run check-ai" to list the ones your key can use)
AI_MODEL=
