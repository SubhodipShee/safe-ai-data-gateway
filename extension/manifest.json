{
  "manifest_version": 3,
  "name": "Safe AI Gateway",
  "version": "0.2.0",
  "description": "Masks Aadhaar, PAN, emails, keys and private code before you send them to ChatGPT, Claude or Gemini, and restores them in the reply.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://safe-ai-gateway.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://safe-ai-gateway.onrender.com/chat-demo.html"
      ],
      "js": [
        "tag-restore.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Safe AI Gateway",
    "default_popup": "popup.html"
  }
}
